    "#| label: fig-ch5-sum-uniforms\n",
    "#| fig-cap: Triangular PDF of U = X + Y for independent Uniform(0, 1) variables.\n",
    "#| echo: false\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "u1 = np.linspace(0, 1, 200)\n",
    "u2 = np.linspace(1, 2, 200)\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.plot(u1, u1)\n",
    "plt.plot(u2, 2-u2)\n",
    "plt.xlabel(\"u\")\n",
    "plt.ylabel(\"f_U(u)\")\n",
    "plt.title(r\"PDF of $U=X+Y$\")\n",
    "plt.grid(True)\n",
    "plt.show()"
